NODE_ENV=development
PORT=4000

DATABASE_URL=
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_a_strong_access_secret
JWT_REFRESH_SECRET=replace_with_a_strong_refresh_secret
CORS_ORIGINS=*

# Refresh token cookie hardening
AUTH_REFRESH_COOKIE_NAME=fabrix_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
# AUTH_REFRESH_COOKIE_DOMAIN=.example.com
